rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'super_admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'super_admin')
      );
    }

    function isDepartmentAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'department_admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'department_admin')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isDepartmentAdmin();
    }

    function isOfficer() {
      return isAuthenticated() && (
        (request.auth.token.role == 'officer') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'officer')
      );
    }

    // =========================================================================
    // USERS COLLECTION RULES
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Users can ONLY create their own profile as 'citizen'
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'citizen'
                    && request.resource.data.accountStatus == 'active'
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email;

      // Users CANNOT change their own role, departmentId, or accountStatus
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'departmentId', 'accountStatus', 'uid', 'email'])
      ) || isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // DEPARTMENTS COLLECTION
    // =========================================================================
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // COMPLAINTS / GRIEVANCES COLLECTION RULES (3-TIER VISIBILITY)
    // =========================================================================
    match /complaints/{complaintId} {
      // Visibility-based Read Access:
      // - PUBLIC & non-sensitive: Readable by authenticated users
      // - PRIVATE & SENSITIVE: Readable ONLY by submitter, assigned Dept Admin, assigned Officer, or Super Admin
      allow read: if isAuthenticated() && (
        (resource.data.visibility == 'PUBLIC' && resource.data.isSensitive == false) ||
        resource.data.citizenId == request.auth.uid ||
        isSuperAdmin() ||
        (isDepartmentAdmin() && resource.data.departmentId == getUserData().departmentId) ||
        (isOfficer() && resource.data.departmentId == getUserData().departmentId)
      );

      // Citizen creation rules:
      // - Must authenticate as the citizen
      // - Initial status must strictly be SUBMITTED
      allow create: if isAuthenticated()
                    && request.resource.data.citizenId == request.auth.uid
                    && request.resource.data.status == 'SUBMITTED'
                    && (!('seenAt' in request.resource.data) || request.resource.data.seenAt == null)
                    && (!('verifiedResolvedAt' in request.resource.data) || request.resource.data.verifiedResolvedAt == null)
                    && (!('assignedOfficerId' in request.resource.data) || request.resource.data.assignedOfficerId == null);

      // Updates and verification gates:
      // - Super Admin can update any field
      // - Department Admin can verify and update grievances for their department
      // - Officers can update status (e.g. SEEN, IN_PROGRESS, RESOLUTION_SUBMITTED) for their department
      // - Citizens can only submit follow-ups / upvotes / community action evidence without altering SLA or Priority fields
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (isDepartmentAdmin() && resource.data.departmentId == getUserData().departmentId) ||
        (isOfficer() && resource.data.departmentId == getUserData().departmentId) ||
        (isOwner(resource.data.citizenId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['citizenId', 'departmentId', 'departmentCode', 'responseSlaHours', 'resolutionSlaHours', 'responseSlaDue', 'resolutionSlaDue', 'priorityScore', 'priorityLevel']))
      );

      allow delete: if isSuperAdmin();

      // Deterministic 1-Citizen-1-Vote Support Subcollection
      match /supports/{supportId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == supportId;
      }

      // Deterministic 1-Citizen-1-Vote Follow-up Subcollection
      match /followups/{followupId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == followupId;
      }
    }

    // =========================================================================
    // SLA EXTENSIONS
    // =========================================================================
    match /sla_extensions/{extensionId} {
      allow read: if isAuthenticated();
      allow create: if isOfficer() || isAdmin();
      allow update: if isSuperAdmin() || (
        isDepartmentAdmin() &&
        resource.data.departmentId == getUserData().departmentId &&
        resource.data.requiresSuperAdmin != true
      );
    }

    // =========================================================================
    // RESOLUTIONS & AUDIT LOGS
    // =========================================================================
    match /resolutions/{resolutionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
